{
  "name": "able-aura-coaching",
  "version": "0.1.0",
  "private": true,
  "description": "Able Aura online group coaching for children with disabilities",
  "scripts": {
    "dev": "concurrently -k -n web,signal -c cyan,magenta \"next dev --turbopack -p 43123\" \"tsx src/server/signalling-process.ts\"",
    "dev:web": "next dev --turbopack -p 43123",
    "dev:signal": "tsx src/server/signalling-process.ts",
    "build": "prisma generate && next build",
    "start": "concurrently -k -n web,signal -c cyan,magenta \"next start -p 43123\" \"tsx src/server/signalling-process.ts\"",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma db push --force-reset && tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.3",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.5",
    "date-fns": "^4.4.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.51.0",
    "next": "^15.5.9",
    "prisma": "^6.16.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "uuid": "^14.0.2",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.2",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
