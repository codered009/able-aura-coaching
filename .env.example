# Local preview uses SQLite so the app runs without RDS credentials.
DATABASE_URL="file:./dev.db"

# Production — Amazon RDS MySQL 8
# Use prisma/schema.mysql.prisma and apply prisma/sql/*.mysql.sql in order.
# DATABASE_URL="mysql://USER:PASSWORD@able-aura.xxxxx.ap-south-1.rds.amazonaws.com:3306/able_aura"

JWT_SECRET="change-me-in-production"
OTP_DEV_CODE="123456"
NEXT_PUBLIC_APP_URL="http://127.0.0.1:43123"
NEXT_PUBLIC_SIGNAL_URL="ws://127.0.0.1:43124"
SIGNAL_PORT="43124"
PORT="43123"

# Optional Razorpay (local demo records payments without these)
# RAZORPAY_KEY_ID=""
# RAZORPAY_KEY_SECRET=""

# Optional S3-compatible storage (local disk is used when unset)
# S3_ENDPOINT=""
# S3_BUCKET=""
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""
